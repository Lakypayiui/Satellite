{
  "name": "satellite-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Satellite desktop app (development build over the local Python backend)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev-app-name": "node scripts/dev-app-name.mjs",
    "postinstall": "node scripts/dev-app-name.mjs",
    "predev": "node scripts/dev-app-name.mjs",
    "prestart": "node scripts/dev-app-name.mjs",
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.mts",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && node scripts/launch.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder"
  },
  "build": {
    "appId": "ai.satellite.desktop",
    "productName": "Satellite",
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "pele": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
