{
  "id": "web_researcher",
  "name": "Web Researcher",
  "description": "Searches the internet, reads pages and downloads files to answer a question with cited sources; all fetched content is untrusted data",
  "capabilities": ["web_search", "web_research", "fetch_web_pages"],
  "prompt_ref": "web_researcher",
  "tools": ["web_search", "web_fetch", "web_download"],
  "validators": [],
  "model_role": "agent",
  "max_turns": 8,
  "timeout_s": 180,
  "output_schema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "description": "Answer or findings for the user, in the user's language, with the evidence found."
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "url": {"type": "string"}
          },
          "required": ["title", "url"],
          "additionalProperties": false
        },
        "description": "Pages actually read or returned by the search."
      }
    },
    "required": ["summary", "sources"],
    "additionalProperties": false
  },
  "lifecycle": "persistent"
}
