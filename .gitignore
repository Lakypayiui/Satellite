*_debug.cpp
*_diag.cpp
*.orig

# --- Estado del framework en proyectos (pruebas locales) ---
.satellite/
.agent/

# --- Editor / IDE / SO ---
.vscode/
.idea/
.vs/
*.swp
*~
*.sublime-*
